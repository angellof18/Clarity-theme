group { name: "e/modules/packagekit/main";
   max: 160 160;
   images.image: "pkg-err.png" COMP;
   images.image: "update-available.png" COMP;
   images.image: "update-done.png" COMP;
   images.image: "update-refresh.png" COMP;
   parts {
      // Icono de "buscando/actualizando": gira (el propio icono)
      part { name: "base";
         clip_to: "busy_clip";
         description { state: "default" 0.0;
            min: 16 16;
            rel1.relative: 0.125 0.125;
            rel2.relative: 0.875 0.875;
            aspect: 1.0 1.0; aspect_preference: BOTH;
            color_class: ":fg";
            image.normal: "update-refresh.png";
            map.on: 1;
            map.smooth: 1;
            map.rotation.center: "base";
         }
         description { state: "spin" 0.0;
            inherit: "default" 0.0;
            map.rotation.z: 360;
         }
      }
      // Icono "sin actualizaciones"
      part { name: "ic_done";
         description { state: "default" 0.0;
            min: 16 16;
            rel1.relative: 0.125 0.125;
            rel2.relative: 0.875 0.875;
            aspect: 1.0 1.0; aspect_preference: BOTH;
            color_class: ":fg";
            image.normal: "update-done.png";
         }
         description { state: "running" 0.0;
            inherit: "default" 0.0;
            visible: 0;
         }
         description { state: "updates" 0.0;
            inherit: "default" 0.0;
            visible: 0;
         }
         description { state: "updated" 0.0;
            inherit: "default" 0.0;
         }
         description { state: "error" 0.0;
            inherit: "default" 0.0;
            visible: 0;
         }
      }
      // Icono "hay actualizaciones" (el numero va en el centro)
      part { name: "ic_avail";
         description { state: "default" 0.0;
            min: 16 16;
            rel1.relative: 0.125 0.125;
            rel2.relative: 0.875 0.875;
            aspect: 1.0 1.0; aspect_preference: BOTH;
            color_class: ":fg";
            image.normal: "update-available.png";
            visible: 0;
         }
         description { state: "running" 0.0;
            inherit: "default" 0.0;
            visible: 0;
         }
         description { state: "updates" 0.0;
            inherit: "default" 0.0;
            visible: 1;
         }
         description { state: "updated" 0.0;
            inherit: "default" 0.0;
            visible: 0;
         }
         description { state: "error" 0.0;
            inherit: "default" 0.0;
            visible: 1;
         }
      }
      part { name: "num_updates"; type: TEXT;
         scale: 1;
         description { state: "default" 0.0;
            rel1.relative: (8/40) (8/40);
            rel2.relative: (32/40) (32/40);
            color_class: ":fg";
            text { font: FN; size: 10;
            }
         }
      }
      part { name: "status";
         description { state: "default" 0.0;
            fixed: 1 1;
            visible: 0;
         }
         description { state: "running" 0.0;
            inherit: "default" 0.0;
            visible: 0;
         }
         description { state: "updates" 0.0;
            inherit: "default" 0.0;
            visible: 0;
         }
         description { state: "updated" 0.0;
            inherit: "default" 0.0;
            visible: 0;
         }
         description { state: "error" 0.0;
            inherit: "default" 0.0;
            visible: 1;
            rel1.relative: (15/40) (15/40);
            rel2.relative: (25/40) (25/40);
            image.normal: "pkg-err.png";
            color_class: ":fg";
         }
      }
      part { name: "busy_clip"; type: RECT;
         description { state: "default" 0.0;
            color: 255 255 255 0; // no cc
            visible: 0;
         }
         description { state: "busy" 0.0;
            inherit: "default" 0.0;
            color: 255 255 255 255; // no cc
            visible: 1;
         }
      }
   }
   programs {
      program { name: "spin";
         signal: "e,state,hung"; source: "e";
         action: STATE_SET "spin" 0.0;
         transition: LINEAR 1.0;
         target: "base";
         after: "spin2";
      }
      program { name: "spin2";
         action: STATE_SET "default" 0.0;
         target: "base";
         after: "spin";
      }
      program { name: "busy-on";
         signal: "e,state,hung"; source: "e";
         action: STATE_SET "busy" 0.0;
         transition: SINUSOIDAL 0.25;
         target: "busy_clip";
      }
      program { name: "busy-off";
         signal: "e,state,unhung"; source: "e";
         action: STATE_SET "default" 0.0;
         transition: SINUSOIDAL 1.0;
         target: "busy_clip";
         after: "spin3";
      }
      program { name: "spin3";
         action: ACTION_STOP;
         target: "spin";
         target: "spin2";
         after: "spin4";
      }
      program { name: "spin4";
         action: STATE_SET "default" 0.0;
         target: "base";
      }

      program {
         signal: "packagekit,state,none"; source: "e";
         action: STATE_SET "default" 0.0;
         target: "status";
         after: "busy-off";
      }
      program {
         signal: "packagekit,state,none"; source: "e";
         in: 1.0 0.0;
         action: STATE_SET "default" 0.0;
         target: "ic_done";
         target: "ic_avail";
      }
      program {
         signal: "packagekit,state,working"; source: "e";
         action: STATE_SET "running" 0.0;
         target: "status";
         target: "ic_done";
         target: "ic_avail";
         after: "spin";
      }
      program {
         signal: "packagekit,state,working"; source: "e";
         action: STATE_SET "running" 0.0;
         target: "status";
         after: "busy-on";
      }
      program {
         signal: "packagekit,state,updates"; source: "e";
         action: STATE_SET "updates" 0.0;
         target: "status";
         after: "busy-off";
      }
      program {
         signal: "packagekit,state,updates"; source: "e";
         in: 1.0 0.0;
         action: STATE_SET "updates" 0.0;
         target: "ic_done";
         target: "ic_avail";
      }
      program {
         signal: "packagekit,state,updated"; source: "e";
         action: STATE_SET "updated" 0.0;
         target: "status";
         after: "busy-off";
      }
      program {
         signal: "packagekit,state,updated"; source: "e";
         in: 1.0 0.0;
         action: STATE_SET "updated" 0.0;
         target: "ic_done";
         target: "ic_avail";
      }
      program {
         signal: "packagekit,state,error"; source: "e";
         action: STATE_SET "error" 0.0;
         target: "status";
         after: "busy-off";
      }
      program {
         signal: "packagekit,state,error"; source: "e";
         in: 1.0 0.0;
         action: STATE_SET "error" 0.0;
         target: "ic_done";
         target: "ic_avail";
      }
   }
}
